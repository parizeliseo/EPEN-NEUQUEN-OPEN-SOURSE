<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- La barra superior la pone cada pantalla (ver Pantalla.kt), de borde a borde. -->
    <style name="Theme.EpenAlDia" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/epen_azul</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">#E3EEF8</item>
        <item name="colorOnPrimaryContainer">@color/epen_azul_osc</item>
        <item name="colorSecondary">@color/epen_amarillo</item>
        <item name="colorSecondaryContainer">#DCE9F6</item>
        <item name="colorOnSecondaryContainer">@color/epen_azul_osc</item>
        <item name="colorSurface">@color/blanco</item>
        <item name="colorOutline">#D5DCE5</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="materialButtonStyle">@style/EpenBoton</item>
        <item name="materialButtonOutlinedStyle">@style/EpenBotonContorno</item>
    </style>
    <style name="EpenBoton" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="EpenBotonContorno" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">#C9D4E2</item>
    </style>
</resources>
